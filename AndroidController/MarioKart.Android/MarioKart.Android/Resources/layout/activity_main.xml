<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/fondo_main_blur">

    <!--==============================================================-->
    <!-- Fondo oscuro -->
    <!--==============================================================-->

    <View

        android:id="@+id/backgroundDim"

        android:layout_width="0dp"

        android:layout_height="0dp"

        android:background="#55000000"

        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"/>

    <!--==============================================================-->
    <!-- Bluetooth -->
    <!--==============================================================-->

    <MarioKart.Android.Controls.FloatingButton

        android:id="@+id/btnBluetooth"

        android:layout_width="72dp"

        android:layout_height="72dp"

        android:layout_margin="24dp"

        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintStart_toStartOf="parent"/>

    <!--==============================================================-->

    <TextView

        android:id="@+id/txtBluetooth"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:text="Disconnected"

        android:textColor="#FFFFFF"

        android:textStyle="bold"

        android:textSize="14sp"

        android:layout_marginTop="8dp"

        app:layout_constraintTop_toBottomOf="@id/btnBluetooth"

        app:layout_constraintStart_toStartOf="@id/btnBluetooth"

        app:layout_constraintEnd_toEndOf="@id/btnBluetooth"/>

    <!--==============================================================-->
    <!-- Configuración -->
    <!--==============================================================-->

    <MarioKart.Android.Controls.FloatingButton

        android:id="@+id/btnSettings"

        android:layout_width="72dp"

        android:layout_height="72dp"

        android:layout_margin="24dp"

        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintEnd_toEndOf="parent"/>

    <!--==============================================================-->
    <!-- Guías -->
    <!--==============================================================-->

    <androidx.constraintlayout.widget.Guideline

        android:id="@+id/guideLeft"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        app:layout_constraintGuide_percent="0.25"/>

    <androidx.constraintlayout.widget.Guideline

        android:id="@+id/guideRight"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        app:layout_constraintGuide_percent="0.75"/>

    <!--==============================================================-->
    <!-- Adelante -->
    <!--==============================================================-->

    <MarioKart.Android.Controls.FloatingButton

        android:id="@+id/btnForward"

        android:layout_width="110dp"

        android:layout_height="110dp"

        app:layout_constraintBottom_toTopOf="@id/btnReverse"

        app:layout_constraintStart_toStartOf="@id/guideLeft"

        app:layout_constraintEnd_toEndOf="@id/guideLeft"

        android:layout_marginBottom="22dp"/>

    <!--==============================================================-->
    <!-- Atrás -->
    <!--==============================================================-->

    <MarioKart.Android.Controls.FloatingButton

        android:id="@+id/btnReverse"

        android:layout_width="110dp"

        android:layout_height="110dp"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="@id/guideLeft"

        app:layout_constraintEnd_toEndOf="@id/guideLeft"

        android:layout_marginBottom="42dp"/>

    <!--==============================================================-->
    <!-- Izquierda -->
    <!--==============================================================-->

  <MarioKart.Android.Controls.FloatingButton

      android:id="@+id/btnLeft"

      android:layout_width="110dp"

      android:layout_height="110dp"

      app:layout_constraintBottom_toBottomOf="parent"

      app:layout_constraintEnd_toEndOf="@id/guideRight"

      android:layout_marginBottom="42dp"

      android:layout_marginEnd="18dp"/>

    <!--==============================================================-->
    <!-- Derecha -->
    <!--==============================================================-->

  <MarioKart.Android.Controls.FloatingButton

      android:id="@+id/btnRight"

      android:layout_width="110dp"

      android:layout_height="110dp"

      app:layout_constraintBottom_toBottomOf="parent"

      app:layout_constraintStart_toStartOf="@id/guideRight"

      android:layout_marginBottom="42dp"

      android:layout_marginStart="18dp"/>

    <!--==============================================================-->
    <!-- Turbo -->
    <!--==============================================================-->

    <MarioKart.Android.Controls.FloatingButton

        android:id="@+id/btnTurbo"

        android:layout_width="130dp"

        android:layout_height="130dp"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginBottom="36dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@drawable/fondo_main_blur">

    <!--==============================================================-->
    <!-- Fondo oscuro -->
    <!--==============================================================-->

    <View

        android:id="@+id/backgroundDim"

        android:layout_width="0dp"

        android:layout_height="0dp"

        android:background="#55000000"

        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"/>

    <!--==============================================================-->
    <!-- Bluetooth -->
    <!--==============================================================-->

    <MarioKart.Android.Controls.FloatingButton

        android:id="@+id/btnBluetooth"
        android:elevation="10dp"

        android:layout_width="72dp"

        android:layout_height="72dp"

        android:layout_margin="24dp"

        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintStart_toStartOf="parent"/>

    <!--==============================================================-->

    <TextView

        android:id="@+id/txtBluetooth"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:text="Disconnected"

        android:textColor="#FFFFFF"

        android:textStyle="bold"

        android:textSize="14sp"

        android:layout_marginTop="8dp"

        app:layout_constraintTop_toBottomOf="@id/btnBluetooth"

        app:layout_constraintStart_toStartOf="@id/btnBluetooth"

        app:layout_constraintEnd_toEndOf="@id/btnBluetooth"/>

  <MarioKart.Android.Controls.FloatingButton

    android:id="@+id/btnProfile"

    android:layout_width="72dp"

    android:layout_height="72dp"

    android:layout_marginEnd="24dp"

    app:layout_constraintTop_toBottomOf="@id/btnSettings"

    app:layout_constraintEnd_toEndOf="parent"/>

  <TextView

    android:id="@+id/txtProfileButton"

    android:layout_width="wrap_content"

    android:layout_height="wrap_content"

    android:text="Profile"

    android:textColor="#FFFFFF"

    android:textStyle="bold"

    android:textSize="14sp"

    android:layout_marginTop="8dp"

    app:layout_constraintTop_toBottomOf="@id/btnProfile"

    app:layout_constraintStart_toStartOf="@id/btnProfile"

    app:layout_constraintEnd_toEndOf="@id/btnProfile"/>
    <!--==============================================================-->
    <!-- Configuración -->
    <!--==============================================================-->

    <MarioKart.Android.Controls.FloatingButton

        android:id="@+id/btnSettings"

        android:layout_width="72dp"

        android:layout_height="72dp"

        android:layout_margin="24dp"

        app:layout_constraintTop_toTopOf="parent"

        app:layout_constraintEnd_toEndOf="parent"/>

    <!--==============================================================-->
    <!-- Guías -->
    <!--==============================================================-->

    <androidx.constraintlayout.widget.Guideline

        android:id="@+id/guideLeft"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        app:layout_constraintGuide_percent="0.25"/>

    <androidx.constraintlayout.widget.Guideline

        android:id="@+id/guideRight"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        app:layout_constraintGuide_percent="0.75"/>

    <!--==============================================================-->
    <!-- Adelante -->
    <!--==============================================================-->

    <MarioKart.Android.Controls.FloatingButton

        android:id="@+id/btnForward"

        android:layout_width="110dp"

        android:layout_height="110dp"

        app:layout_constraintBottom_toTopOf="@id/btnReverse"

        app:layout_constraintStart_toStartOf="@id/guideLeft"

        app:layout_constraintEnd_toEndOf="@id/guideLeft"

        android:layout_marginBottom="22dp"/>

    <!--==============================================================-->
    <!-- Atrás -->
    <!--==============================================================-->

    <MarioKart.Android.Controls.FloatingButton

        android:id="@+id/btnReverse"

        android:layout_width="110dp"

        android:layout_height="110dp"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="@id/guideLeft"

        app:layout_constraintEnd_toEndOf="@id/guideLeft"

        android:layout_marginBottom="42dp"/>

    <!--==============================================================-->
    <!-- Izquierda -->
    <!--==============================================================-->

  <MarioKart.Android.Controls.FloatingButton

      android:id="@+id/btnLeft"

      android:layout_width="110dp"

      android:layout_height="110dp"

      app:layout_constraintBottom_toBottomOf="parent"

      app:layout_constraintEnd_toEndOf="@id/guideRight"

      android:layout_marginBottom="42dp"

      android:layout_marginEnd="18dp"/>

    <!--==============================================================-->
    <!-- Derecha -->
    <!--==============================================================-->

  <MarioKart.Android.Controls.FloatingButton

      android:id="@+id/btnRight"

      android:layout_width="110dp"

      android:layout_height="110dp"

      app:layout_constraintBottom_toBottomOf="parent"

      app:layout_constraintStart_toStartOf="@id/guideRight"

      android:layout_marginBottom="42dp"

      android:layout_marginStart="18dp"/>

    <!--==============================================================-->
    <!-- Turbo -->
    <!--==============================================================-->

    <MarioKart.Android.Controls.FloatingButton

        android:id="@+id/btnTurbo"

        android:layout_width="130dp"

        android:layout_height="130dp"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginBottom="36dp"/>

  <!--==============================================================-->
  <!-- Developer Panel -->
  <!--==============================================================-->

  <LinearLayout
      android:id="@+id/layoutDeveloper"

      android:layout_width="0dp"

      android:layout_height="wrap_content"

      android:orientation="vertical"

      android:gravity="center_horizontal"

      android:padding="8dp"

      android:minHeight="72dp"

      android:background="@drawable/developer_panel"

      android:visibility="gone"

      android:layout_marginTop="20dp"

      android:layout_marginStart="12dp"

      android:layout_marginEnd="12dp"

      app:layout_constraintTop_toTopOf="parent"

      app:layout_constraintStart_toEndOf="@id/btnBluetooth"

      app:layout_constraintEnd_toStartOf="@id/btnSettings">

    <!--==========================================================-->
    <!-- Título -->
    <!--==========================================================-->

    <TextView
        android:id="@+id/txtProfileTitle"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:text="DRIVER PROFILE"

        android:textColor="#BBBBBB"

        android:textStyle="bold"

        android:textSize="10sp"/>

    <!--==========================================================-->
    <!-- Perfil + LED -->
    <!--==========================================================-->

    <LinearLayout
    android:id="@+id/layoutProfile"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerHorizontal="true"
    android:layout_below="@id/btnBluetooth"
    android:layout_marginTop="5dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/developer_panel"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

      <View
          android:id="@+id/viewProfileIndicator"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:layout_marginEnd="10dp"
          android:background="@drawable/circle_blue"/>

      <TextView
          android:id="@+id/txtProfile"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="CONNECTING..."
          android:textStyle="bold"
          android:textColor="@android:color/white"
          android:textSize="14sp"/>

    </LinearLayout>

    <!--==========================================================-->
    <!-- Telemetría -->
    <!--==========================================================-->

    <TextView
        android:id="@+id/txtTelemetry"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:layout_marginTop="6dp"

        android:text="TX:0    RX:0"

        android:textColor="#DDDDDD"

        android:textSize="12sp"/>

    <!--==========================================================-->
    <!-- RSSI -->
    <!--==========================================================-->

    <TextView
        android:id="@+id/txtRSSI"

        android:layout_width="wrap_content"

        android:layout_height="wrap_content"

        android:text="RSSI: -- dBm"

        android:textColor="#AAAAAA"

        android:textSize="11sp"/>

  </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
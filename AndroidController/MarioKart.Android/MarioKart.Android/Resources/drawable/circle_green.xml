<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Halo exterior -->

  <item>

    <shape android:shape="oval">

      <size
          android:width="14dp"
          android:height="14dp"/>

      <gradient
          android:type="radial"
          android:gradientRadius="12dp"
          android:centerColor="#802196F3"
          android:endColor="#002196F3"/>

    </shape>

  </item>

  <!-- LED -->

  <item
      android:left="2dp"
      android:top="2dp"
      android:right="2dp"
      android:bottom="2dp">

    <shape android:shape="oval">

      <gradient
          android:angle="270"
          android:startColor="#5BB75C"
          android:centerColor="#5bb75c"
          android:endColor="#4CAF50"/>

      <stroke
          android:width="1dp"
          android:color="#A0FFFFFF"/>

    </shape>

  </item>

</layer-list>